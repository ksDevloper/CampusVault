{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusvault-api",
  "main": "worker.js",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare D1 Database Binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campusvault-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],

  // Optional: Cloudflare R2 Bucket Binding (Only if R2 is activated with payment method)
  // "r2_buckets": [
  //   {
  //     "binding": "BUCKET",
  //     "bucket_name": "campusvault-uploads"
  //   }
  // ]
}
